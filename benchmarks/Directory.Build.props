<Project>

  <!-- 与 tests/benchmarks 同一个坑：本文件的 Import 会顶掉上一级那份，必须显式接回来。
       仓库根那份再接 sql 家那份没有 —— 这条链只到 job/ 一层（仓库根 → job/ → 本层）。 -->
  <Import Project="..\Directory.Build.props" />

  <!-- 本层自钉单档 net10.0：对照组 TickerQ 钉 10.4.0（最后 MIT 档），与它同档对跑。
       全子树根已是 net10.0;net11.0 多目标，本层用 TargetFramework 覆盖回单 TFM。
       BenchmarkDotNet 对 TFM 自己挑最高档，与 QuickJob 不冲突。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
  </PropertyGroup>

</Project>
